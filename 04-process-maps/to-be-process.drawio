="34" as="geometry"/></mxCell><mxCell id="c70" value="I2" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1004" width="30" height="26" as="geometry"/></mxCell><mxCell id="c71" value="Fixes P2: promised date includes a route and state buffer, tested on cross-state routes first (BO-2, BR-03, US-05)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c72" value="I3" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1038" width="30" height="26" as="geometry"/></mxCell><mxCell id="c73" value="Fixes P3: orders in the 7+ day dispatch band or on cross-state routes are flagged at risk, and CX contacts the customer before the date is missed (BR-06, US-07)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1034" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c74" value="I4" style="ellipse;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1072" width="30" height="26" as="geometry"/></mxCell><mxCell id="c75" value="Fixes P4: one daily dashboard with shared KPI definitions feeds the scorecard and the at-risk rule (BR-01, BR-05, NFR-01, NFR-02)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1068" width="1500" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>