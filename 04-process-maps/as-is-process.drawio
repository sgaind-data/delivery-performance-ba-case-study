e=10;" vertex="1" parent="1"><mxGeometry x="344" y="221.0" width="30" height="26" as="geometry"/></mxCell><mxCell id="c47" value="P3" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1874" y="611.0" width="30" height="26" as="geometry"/></mxCell><mxCell id="c48" value="P4" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2044" y="611.0" width="30" height="26" as="geometry"/></mxCell><mxCell id="c49" value="Pain points (verified findings; associations, not proven causes)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="900" height="24" as="geometry"/></mxCell><mxCell id="c50" value="P1" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="30" height="26" as="geometry"/></mxCell><mxCell id="c51" value="No dispatch standard: orders handed to the carrier after 7+ days are late 21.39% of the time, vs 3.81% within 0–1 days." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="776" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c52" value="P2" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="814" width="30" height="26" as="geometry"/></mxCell><mxCell id="c53" value="One promise rule for every route: cross-state orders are late 8.03% vs 4.52% same-state, and make up 76.1% of late orders." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c54" value="P3" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="848" width="30" height="26" as="geometry"/></mxCell><mxCell id="c55" value="Lateness is discovered only when the customer complains: 62.42% of late orders get 1–2 star reviews (vs 9.27% on time)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="844" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c56" value="P4" style="ellipse;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="882" width="30" height="26" as="geometry"/></mxCell><mxCell id="c57" value="No shared, trusted view of delivery KPIs, so each case is handled on its own and root causes are not tracked." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="1500" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>